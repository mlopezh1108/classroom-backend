{
  "name": "Classroom Dev Environment (Mandrel Java 21)",
  "dockerComposeFile": [
    "../compose.yaml",
    "docker-compose.yml"
  ],
  "service": "app",
  "workspaceFolder": "/workspace",
  "forwardPorts": [8080, 5432],
  "remoteUser": "quarkus",
  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "vmware.vscode-spring-boot",
        "vscjava.vscode-gradle"
      ]
    }
  }
}
